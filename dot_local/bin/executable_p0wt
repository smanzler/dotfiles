#!/usr/bin/env bash
# p0wt — create and manage app worktrees. The front door; p0finish is the back one.
#
# A worktree's path IS its branch: refs/heads/simonmanzler/eng-8346-foo lives at
# ~/repos/simonmanzler/eng-8346-foo. That one rule makes the mapping reversible
# without any state file, and it is already how 5 of the existing worktrees are
# laid out. p0name shortens the path to the ticket for tmux/status-bar use.
#
# Usage:
#   p0wt                        # list (same as `p0wt list`)
#   p0wt new                    # pick a branch (or type a new name) with fzf
#   p0wt new BRANCH             # worktree for BRANCH + tmux window + p0init
#   p0wt new BRANCH --switch    # ...and jump to the window
#   p0wt new BRANCH --base main # branch off something other than the current dir
#   p0wt go NAME                # focus (or open) a worktree's tmux window
#   p0wt restore                # a window for every worktree, newest first
#   p0wt prune                  # pick any worktrees to remove, done ones first
#   p0wt prune --yes            # ...no picker, remove every done one
#   p0wt prune --force          # ...do not ask about uncommitted changes
#   p0wt rm NAME                # p0finish --window, then delete the worktree
#   p0wt rm NAME --force        # ...even with uncommitted changes
#   p0wt doctor                 # prune stale registrations, report unbootstrapped
#   p0wt <cmd> --dry-run        # print the plan, change nothing
#
# `new` auto-detects: an existing local or origin branch is checked out, anything
# else is created off the current directory's branch. It never guesses silently —
# every run prints which of the three it picked and what it branched from.

set -uo pipefail

REPOS="${P0_REPOS:-$HOME/repos}"
REMOTE="${P0_REMOTE:-origin}"
DRY=0

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '\033[33m  %s\033[0m\n' "$*"; }
die()  { printf '\033[31mp0wt: %s\033[0m\n' "$*" >&2; exit 1; }
run()  { if [ "$DRY" = 1 ]; then printf '  [dry-run] %s\n' "$*"; else eval "$@"; fi; }
usage() { sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------- repo context
# Every worktree of a repo can list all the others, so any one of them works as
# an entry point. Prefer the cwd's so `p0wt` is usable from a worktree that is
# not under $REPOS at all; fall back to $REPOS/app for a bare shell.
git_entry() {
  local root
  if root=$(git rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' "$root"
    return 0
  fi
  if [ -e "$REPOS/app/.git" ]; then
    printf '%s\n' "$REPOS/app"
    return 0
  fi
  return 1
}

# The repo's main worktree — first entry of `worktree list`, same as p0init uses.
main_worktree() {
  git -C "$1" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}'
}

worktree_dirs() {
  git -C "$1" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}'
}

branch_of() {
  git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null
}

is_dirty() {
  [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]
}

# Short name, via p0name so there is exactly one implementation of the mapping.
short_name() {
  local n
  n=$(p0name "$1" 2>/dev/null) && [ -n "$n" ] && { printf '%s\n' "$n"; return 0; }
  basename "$1"
}

# The branch "done" test needs something to be done relative to. origin/HEAD is
# authoritative; fall back to main/master so this still works on a repo where
# nobody ever set it.
default_branch() {
  local entry="$1" b c
  if b=$(git -C "$entry" symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null); then
    printf '%s\n' "${b#"$REMOTE"/}"
    return 0
  fi
  for c in main master; do
    if git -C "$entry" show-ref --verify --quiet "refs/remotes/$REMOTE/$c"; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  printf 'main\n'
}

# Widest short name across the repo's worktrees, so table columns line up
# whether every branch has a ticket or none of them do.
name_width() {
  local w=8 n
  while read -r d; do
    n=$(short_name "$d")
    [ ${#n} -gt "$w" ] && w=${#n}
  done < <(worktree_dirs "$1")
  printf '%s\n' "$w"
}

dir_mtime() {
  stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null || echo 0
}

# Plain `git worktree remove` dies with "working trees containing submodules
# cannot be moved or removed" on every app worktree that p0init has touched, so
# always use --force: it gets past that and takes the directory with it (git
# 2.55). Fall back to deleting the directory ourselves for an older git or any
# other objection — nothing in there is worth keeping, p0init regenerates
# node_modules and .env.yarn.local in a couple of minutes.
#
# --force also discards uncommitted changes without asking, which is the check
# plain `remove` used to provide, so callers gate on `clean` themselves.
remove_worktree() {
  local entry="$1" dir="$2"

  if [ "$DRY" = 1 ]; then
    info "[dry-run] git -C $entry worktree remove --force $dir"
    info "[dry-run]   (falls back to rm -rf + git worktree prune if git refuses)"
    return 0
  fi

  git -C "$entry" worktree remove --force "$dir" 2>/dev/null && return 0

  warn "git would not remove it — deleting the directory instead"
  rm -rf "$dir" || return 1
  # prune only drops the registration once the directory is actually gone.
  git -C "$entry" worktree prune
  [ ! -e "$dir" ]
}

# ----------------------------------------------------------------------- tmux
# Window targets are "=session:name" and session targets "=name:". Both the '='
# and the trailing ':' matter: bare -t prefix-matches, and '=' alone still loses
# to a same-named window in another session. p0up/p0down document the same trap.
in_tmux() { [ -n "${TMUX:-}" ]; }

current_session() {
  tmux display-message -p -t "${TMUX_PANE:-}" '#S' 2>/dev/null
}

# Deliberately not `select-window`: that focuses as a side effect, which would
# make `restore` jump through every window it checks and would move focus on a
# detached `new`.
window_exists() {
  tmux list-windows -t "=$1:" -F '#{window_name}' 2>/dev/null | grep -Fxq "$2"
}

# Focus the window for a worktree, creating it if absent. Idempotent, so calling
# it twice jumps rather than stacking duplicates. A command is only sent when we
# created the window — send-keys into an existing one would type into whatever is
# running there. send-keys rather than a window command so it lands in the real
# interactive shell, with nvm and PATH set up the way tmuxinator drives its panes.
# Sets WINDOW_STATE to created | existing | none, so a caller can tell whether
# the command it passed actually ran.
WINDOW_STATE=none
open_window() {
  local dir="$1" name="$2" detach="${3:-1}" command="${4:-}"
  local session args

  WINDOW_STATE=none
  in_tmux || { warn "not inside tmux — no window opened"; return 1; }
  session=$(current_session) || { warn "cannot resolve tmux session"; return 1; }

  if window_exists "$session" "$name"; then
    WINDOW_STATE=existing
    if [ "$detach" = 1 ]; then
      info "window '$name' already exists"
    else
      run "tmux select-window -t '=$session:$name'"
      info "window '$name' already exists — focused it"
    fi
    return 0
  fi

  args="new-window -a -t '=$session:' -c '$dir' -n '$name'"
  [ "$detach" = 1 ] && args="$args -d"
  run "tmux $args" || return 1

  if [ -n "$command" ]; then
    run "tmux send-keys -t '=$session:$name' $(printf '%q' "$command") Enter"
  fi

  WINDOW_STATE=created
  info "window '$name' created$([ "$detach" = 1 ] && echo ' (detached)')"
}

# --------------------------------------------------------------------- new
# A typed name is prose until it is not: whitespace becomes dashes, so
# "eng-8346 fix the thing" is a legal ref.
slug() {
  printf '%s' "$1" | tr -s '[:space:]' '-' | sed 's/^-*//; s/-*$//'
  printf '\n'
}

# Every branch `new` could check out, newest commit first: local ones, then the
# $REMOTE-only ones. Field 1 is the branch, field 2 is what fzf shows. A branch
# some worktree already holds is tagged, because `new` will bounce off it.
branch_choices() {
  local entry="$1" ref rel held seen=""
  held=$(git -C "$entry" worktree list --porcelain \
    | awk '/^branch /{sub(/^refs\/heads\//, "", $2); print " " $2 " "}' | tr -d '\n')

  while IFS="$(printf '\t')" read -r ref rel; do
    seen="$seen $ref "
    case "$held" in
      *" $ref "*) printf '%s\t\033[36m%-6s\033[0m %-58s %s\n' "$ref" "wt" "$ref" "$rel" ;;
      *)          printf '%s\t%-6s %-58s %s\n' "$ref" "local" "$ref" "$rel" ;;
    esac
  done < <(git -C "$entry" for-each-ref --sort=-committerdate \
    --format="%(refname:short)%09%(committerdate:relative)" refs/heads)

  while IFS="$(printf '\t')" read -r ref rel; do
    ref=${ref#"$REMOTE"/}
    [ "$ref" = HEAD ] && continue
    case "$seen" in *" $ref "*) continue ;; esac
    printf '%s\t%-6s %-58s %s\n' "$ref" "$REMOTE" "$ref" "$rel"
  done < <(git -C "$entry" for-each-ref --sort=-committerdate \
    --format="%(refname:short)%09%(committerdate:relative)" "refs/remotes/$REMOTE")
}

# Pick a branch, or name one that does not exist yet. --print-query puts the
# typed text on line 1 and the highlighted row, if any, on line 2 — so a query
# that matches nothing is still an answer. Esc (130) is not.
pick_branch() {
  local out status query choice
  out=$(fzf --print-query --ansi \
    --delimiter="$(printf '\t')" --with-nth=2 \
    --height=60% --border=none --info=inline --pointer='>' \
    --color=bg:-1,gutter:-1,border:-1 \
    --prompt='branch > ' \
    --header='enter checkout · type a name that matches nothing to create it' \
    < <(branch_choices "$1"))
  status=$?
  [ "$status" -ge 2 ] && return 1

  query=$(sed -n 1p <<<"$out")
  choice=$(sed -n 2p <<<"$out")
  if [ -n "$choice" ]; then
    cut -f1 <<<"$choice"
  else
    slug "$query"
  fi
}

cmd_new() {
  local branch="" base="" switch=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --switch|-s) switch=1 ;;
      --base)      base="${2:?--base needs a ref}"; shift ;;
      --dry-run|-n) DRY=1 ;;
      -*)          die "unknown flag '$1' (try --help)" ;;
      # Loose words are one name: slug() joins them with dashes below.
      *)           branch="${branch:+$branch }$1" ;;
    esac
    shift
  done
  local entry dir
  entry=$(git_entry) || die "not in a git worktree and no $REPOS/app to fall back on"

  if [ -z "$branch" ] && command -v fzf >/dev/null 2>&1 && [ -c /dev/tty ]; then
    branch=$(pick_branch "$entry") || die "nothing picked"
  fi
  [ -n "$branch" ] || die "which branch? e.g. p0wt new simonmanzler/eng-1234-thing"

  branch=$(slug "$branch")
  git -C "$entry" check-ref-format --branch "$branch" >/dev/null 2>&1 \
    || die "'$branch' is not a legal branch name"
  dir="$REPOS/$branch"

  step "Target"
  info "branch:   $branch"
  info "worktree: $dir"

  # An existing directory is either the worktree we want (jump to it) or an
  # unrelated collision (refuse rather than clobber).
  if [ -e "$dir" ]; then
    if [ "$(branch_of "$dir")" = "$branch" ]; then
      info "already exists on this branch — opening its window"
      open_window "$dir" "$(short_name "$dir")" "$([ "$switch" = 1 ] && echo 0 || echo 1)"
      exit 0
    fi
    die "$dir exists and is not on $branch — move it aside first"
  fi

  step "Fetching $REMOTE"
  run "git -C '$entry' fetch --prune '$REMOTE'"

  # ------------------------------------------------------- pick the source ref
  local mode add_args
  if git -C "$entry" show-ref --verify --quiet "refs/heads/$branch"; then
    mode="existing local branch"
    # Refuse early with a useful message: git's own error for this is opaque.
    local held
    held=$(git -C "$entry" worktree list --porcelain \
      | awk -v b="refs/heads/$branch" '/^worktree /{w=$2} $0=="branch "b{print w}')
    [ -n "$held" ] && die "$branch is already checked out at $held (try: p0wt go $(short_name "$held"))"
    add_args="'$dir' '$branch'"
  elif git -C "$entry" show-ref --verify --quiet "refs/remotes/$REMOTE/$branch"; then
    mode="existing $REMOTE branch"
    add_args="--track -b '$branch' '$dir' '$REMOTE/$branch'"
  else
    mode="new branch"
    local base_ref base_desc
    if [ -n "$base" ]; then
      base_ref="$base"; base_desc="$base (--base)"
    else
      # Base off the current directory's branch, per the "branch in the current
      # dir" rule. If that branch is strictly behind its upstream, branch from
      # the upstream instead so a new ticket does not start stale; if it has
      # local commits, keep them. Either way, say which.
      local cur counts ahead behind
      cur=$(branch_of "$entry") || die "cannot resolve the current branch"
      base_ref="HEAD"; base_desc="$cur (local HEAD)"
      if counts=$(git -C "$entry" rev-list --left-right --count "HEAD...@{u}" 2>/dev/null); then
        ahead=${counts%%[[:space:]]*}; behind=${counts##*[[:space:]]}
        if [ "$ahead" = 0 ] && [ "$behind" -gt 0 ]; then
          base_ref="@{u}"; base_desc="$REMOTE/$cur ($cur was $behind behind)"
        elif [ "$ahead" -gt 0 ]; then
          base_desc="$cur (local HEAD, $ahead unpushed)"
        fi
      fi
    fi
    info "base:     $base_desc"
    add_args="-b '$branch' '$dir' '$base_ref'"
  fi
  info "mode:     $mode"

  step "Creating worktree"
  run "git -C '$entry' worktree add $add_args" || die "git worktree add failed"

  step "tmux window"
  local name
  name=$(short_name "$dir")
  # p0init is slow (submodules + yarn install), so the window starts detached and
  # you carry on where you are. The pane shows the full command, re-runnable as-is.
  open_window "$dir" "$name" "$([ "$switch" = 1 ] && echo 0 || echo 1)" \
    "p0init $(printf '%q' "$dir")"

  step "Ready"
  if [ "$DRY" = 1 ]; then
    warn "Dry run — nothing changed."
    return 0
  fi

  info "$dir on $branch"
  if [ "$WINDOW_STATE" = created ]; then
    info "p0init is running in window '$name'"
  else
    # No window means nothing ran p0init, and the worktree is unusable until it
    # does, so hand over the exact command instead of implying it is underway.
    info "not bootstrapped yet — run: p0init $dir"
  fi
}

# -------------------------------------------------------------------- list
cmd_list() {
  local entry
  entry=$(git_entry) || die "not in a git worktree and no $REPOS/app to fall back on"

  local session=""
  in_tmux && session=$(current_session)

  local w
  w=$(name_width "$entry")
  printf "\033[1m%-${w}s %-6s %-5s %s\033[0m\n" NAME WINDOW INIT BRANCH
  while read -r dir; do
    local name win init branch
    name=$(short_name "$dir")
    branch=$(branch_of "$dir")

    win="-"
    [ -n "$session" ] && window_exists "$session" "$name" && win="yes"

    # "init" means p0init has been run: node_modules is the expensive half and
    # the one that makes the worktree actually usable.
    init="no"
    [ -d "$dir/node_modules" ] && init="yes"

    printf "%-${w}s %-6s %-5s %s\n" "$name" "$win" "$init" "${branch:-?}"
  done < <(worktree_dirs "$entry")
}

# ---------------------------------------------------------------------- go
cmd_go() {
  local want=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) DRY=1 ;;
      -*) die "unknown flag '$1'" ;;
      *)  [ -n "$want" ] && die "one worktree at a time"; want="$1" ;;
    esac
    shift
  done
  [ -n "$want" ] || die "which worktree? (see: p0wt list)"

  local dir
  dir=$(p0name --find "$want" 2>/dev/null) \
    || die "no worktree named '$want' (see: p0wt list)"

  open_window "$dir" "$(short_name "$dir")" 0
}

# ---------------------------------------------------------------------- rm
cmd_rm() {
  local want="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force|-f)   force=1 ;;
      --dry-run|-n) DRY=1 ;;
      -*) die "unknown flag '$1'" ;;
      *)  [ -n "$want" ] && die "one worktree at a time"; want="$1" ;;
    esac
    shift
  done
  [ -n "$want" ] || die "which worktree? (see: p0wt list)"

  local entry dir main
  entry=$(git_entry) || die "not in a git worktree"
  dir=$(p0name --find "$want" 2>/dev/null) || die "no worktree named '$want'"
  main=$(main_worktree "$entry")

  [ "$dir" = "$main" ] && die "$dir is the main worktree — not removing that"
  case "$PWD/" in
    "$dir"/*) die "you are inside $dir — cd out first" ;;
  esac

  # --force no longer only relaxes git's own refusal: remove_worktree always
  # passes --force, so this is the only thing standing between a typo and
  # uncommitted work.
  if [ "$force" != 1 ] && [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    die "$dir has uncommitted changes — commit them, or re-run with --force"
  fi

  step "Target"
  info "worktree: $dir"
  info "branch:   $(branch_of "$dir")"

  # p0finish owns teardown and refuses (non-zero) when an editor holds unsaved
  # work, which is exactly the signal to abort before touching the checkout.
  step "Closing editors, stack and window"
  if [ "$DRY" = 1 ]; then
    info "[dry-run] p0finish --window $dir"
  elif command -v p0finish >/dev/null 2>&1; then
    p0finish --window "$dir" || die "p0finish refused — worktree left alone"
  else
    warn "p0finish not on PATH — skipping teardown"
  fi

  step "Removing worktree"
  remove_worktree "$entry" "$dir" || die "could not remove $dir"

  step "Done"
  if [ "$DRY" = 1 ]; then
    warn "Dry run — nothing changed."
  else
    info "$dir removed"
  fi
}

# ------------------------------------------------------------------ doctor
cmd_doctor() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) DRY=1 ;;
      *) die "unknown arg '$1'" ;;
    esac
    shift
  done

  local entry
  entry=$(git_entry) || die "not in a git worktree"

  step "Stale registrations"
  local stale
  stale=$(git -C "$entry" worktree prune --dry-run --verbose 2>/dev/null)
  if [ -n "$stale" ]; then
    printf '%s\n' "$stale" | sed 's/^/  /'
    run "git -C '$entry' worktree prune"
  else
    info "none"
  fi

  step "Bootstrap state"
  local problems=0
  while read -r dir; do
    local missing=()
    [ -d "$dir/node_modules" ] || missing+=(node_modules)
    [ -f "$dir/.env.yarn.local" ] || missing+=(.env.yarn.local)
    # An uninitialised submodule shows as "-<sha>" in `submodule status`.
    if [ -f "$dir/.gitmodules" ] && git -C "$dir" submodule status 2>/dev/null | grep -q '^-'; then
      missing+=(submodules)
    fi
    if [ ${#missing[@]} -gt 0 ]; then
      problems=$((problems + 1))
      printf '  \033[33m%-14s missing: %s\033[0m\n' "$(short_name "$dir")" "${missing[*]}"
      printf '                 fix: p0init %s\n' "$dir"
    fi
  done < <(worktree_dirs "$entry")
  [ "$problems" = 0 ] && info "every worktree is bootstrapped"
}

# ------------------------------------------------------------------ restore
# Rebuild the window layout after a reboot. No p0init: these worktrees are
# already bootstrapped, and re-running it on all of them would be minutes of
# yarn for nothing.
cmd_restore() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run|-n) DRY=1 ;;
      *) die "unknown arg '$1'" ;;
    esac
    shift
  done

  in_tmux || die "not inside tmux — start a session first"
  local entry session
  entry=$(git_entry) || die "not in a git worktree and no $REPOS/app to fall back on"
  session=$(current_session) || die "cannot resolve the tmux session"

  # Oldest -> newest, so that the reorder pass below has a stable list to walk
  # backwards. bash 3.2 has no readarray.
  local dirs=() dir
  while read -r dir; do
    dirs+=("$dir")
  done < <(
    while read -r d; do
      printf '%s\t%s\n' "$(dir_mtime "$d")" "$d"
    done < <(worktree_dirs "$entry") | sort -n | cut -f2-
  )

  step "Opening windows in $session (newest first)"
  local created=0 existing=0 name
  for dir in "${dirs[@]}"; do
    name=$(short_name "$dir")
    if open_window "$dir" "$name" 1; then
      case "$WINDOW_STATE" in
        created)  created=$((created + 1)) ;;
        existing) existing=$((existing + 1)) ;;
      esac
    fi
  done

  # Creating with `new-window -a` puts each window right after the current one,
  # which happens to come out newest-first for a full restore — but a partial
  # one leaves the windows it just refilled bunched at the front. So place them
  # explicitly: walk newest -> oldest, chaining each after the previous, anchored
  # on the window we are sitting in. Window ids (@N) survive the renumbering
  # that every move triggers; indices do not.
  step "Ordering"
  local anchor prev i
  anchor=$(tmux display-message -p '#{window_id}' 2>/dev/null) \
    || { warn "cannot resolve the current window — order left as-is"; anchor=""; }
  if [ -n "$anchor" ]; then
    prev="$anchor"
    for (( i=${#dirs[@]} - 1; i >= 0; i-- )); do
      name=$(short_name "${dirs[$i]}")
      window_exists "$session" "$name" || continue
      run "tmux move-window -d -a -s '=$session:$name' -t '$prev'"
      prev="=$session:$name"
    done
    info "newest first, oldest last"
  fi

  step "Done"
  if [ "$DRY" = 1 ]; then
    warn "Dry run — nothing changed."
  else
    info "$created opened, $existing already there"
  fi
}

# -------------------------------------------------------------------- prune
# The checkbox prompt: space marks a row, enter confirms. Rows come in as
# "dir<TAB>display" and only the dir is printed back. fzf reads the keyboard from
# /dev/tty, so this still works with stdout piped. With nothing marked fzf
# returns the highlighted row, which is why enter always removes at least one.
pick_worktrees() {
  local out
  out=$(fzf --multi --ansi \
    --delimiter="$(printf '\t')" --with-nth=2 \
    --height=60% --border=none --info=inline --pointer='>' --marker='*' \
    --color=bg:-1,gutter:-1,border:-1 \
    --header='space select · enter remove · ctrl-a all · esc cancel' \
    --bind='space:toggle+down' \
    --bind='ctrl-a:select-all' \
    --bind='ctrl-d:deselect-all' \
    < <(printf '%s\n' "$@")) || return 1
  [ -n "$out" ] || return 1
  cut -f1 <<<"$out"
}

# What "done with a branch" can actually be detected as. Closing the tmux window
# is not usable as the signal — a reboot closes every window — so this asks git
# instead, and the verdict column always says which test fired.
#
# Removing a worktree does NOT delete its branch, so no commit is ever lost here;
# the cost is a yarn install and the gitignored files p0init regenerates. That is
# why `clean` is the only hard safety gate.
#
# A branch with no upstream configured is genuinely ambiguous: a missing
# origin ref means either "merged and deleted" or "never pushed", and git keeps
# no record of the difference. Those are listed but kept unless --include-local.
prune_verdict() {
  local dir="$1" entry="$2" base="$3" branch remote

  [ "$dir" = "$(main_worktree "$entry")" ] && { echo "keep main"; return; }
  case "$PWD/" in "$dir"/*) echo "keep current"; return ;; esac
  is_dirty "$dir" && { echo "keep dirty"; return; }

  branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null) \
    || { echo "keep detached"; return; }

  if git -C "$entry" merge-base --is-ancestor "$branch" "$REMOTE/$base" 2>/dev/null; then
    echo "prune merged"
    return
  fi

  remote=$(git -C "$dir" config --get "branch.$branch.remote" 2>/dev/null || true)
  if [ -n "$remote" ]; then
    if git -C "$dir" rev-parse --verify --quiet "refs/remotes/$remote/$branch" >/dev/null; then
      echo "keep active"
    else
      echo "prune gone"
    fi
  else
    echo "local no-upstream"
  fi
}

cmd_prune() {
  local yes=0 include_local=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y)        yes=1 ;;
      --force|-f)      force=1 ;;
      --include-local) include_local=1 ;;
      --dry-run|-n)    DRY=1 ;;
      -*) die "unknown flag '$1'" ;;
      *)  die "prune takes no arguments (did you mean: p0wt rm $1?)" ;;
    esac
    shift
  done

  local entry base
  entry=$(git_entry) || die "not in a git worktree and no $REPOS/app to fall back on"
  base=$(default_branch "$entry")

  step "Stale registrations"
  local stale
  stale=$(git -C "$entry" worktree prune --dry-run --verbose 2>/dev/null)
  if [ -n "$stale" ]; then
    printf '%s\n' "$stale" | sed 's/^/  /'
    run "git -C '$entry' worktree prune"
  else
    info "none"
  fi

  step "Fetching $REMOTE (so 'gone' means gone)"
  run "git -C '$entry' fetch --prune '$REMOTE'"

  step "Verdicts (base: $REMOTE/$base)"
  local candidates=() rows=() others=() verdict action reason row w
  w=$(name_width "$entry")
  printf "  \033[1m%-${w}s %-11s %s\033[0m\n" NAME VERDICT BRANCH
  while read -r dir; do
    verdict=$(prune_verdict "$dir" "$entry" "$base")
    action=${verdict%% *}
    reason=${verdict#* }

    if [ "$action" = local ] && [ "$include_local" = 1 ]; then
      action=prune; reason="no-upstream"
    fi

    local color="0"
    [ "$action" = prune ] && color="33"
    [ "$action" = local ] && color="36"
    printf "  \033[%sm%-${w}s %-11s %s\033[0m\n" "$color" \
      "$(short_name "$dir")" "$reason" "$(branch_of "$dir")"

    # Everything git can actually remove is offered to the picker, verdict and
    # all — the verdict orders the list, it does not limit it. Only the main
    # worktree and the one you are standing in are left out: git refuses both.
    row=$(printf '%s\t%-*s  %-11s %s' "$dir" "$w" \
      "$(short_name "$dir")" "$reason" "$(branch_of "$dir")")
    if [ "$action" = prune ]; then
      candidates+=("$dir")
      rows+=("$row")
    elif [ "$reason" != main ] && [ "$reason" != current ]; then
      others+=("$row")
    fi
  done < <(worktree_dirs "$entry")

  [ ${#others[@]} -gt 0 ] && rows+=("${others[@]}")

  # Without fzf or a terminal there is nothing to pick with, so keep the old
  # all-or-nothing question as the fallback.
  local pick=0
  if [ "$yes" != 1 ] && [ "$DRY" != 1 ] && [ ${#rows[@]} -gt 0 ] \
     && command -v fzf >/dev/null 2>&1 && [ -c /dev/tty ]; then
    pick=1
  fi

  if [ ${#candidates[@]} -eq 0 ]; then
    step "Nothing to prune"
    [ "$include_local" = 1 ] || info "pass --include-local to also consider no-upstream branches"
    [ "$pick" = 1 ] || return 0
    info "pick by hand instead — ${#rows[@]} worktrees to choose from"
  else
    step "Prunable: ${#candidates[@]}"
    info "branches are kept, so nothing but gitignored files and a yarn install is lost"
  fi

  if [ "$DRY" = 1 ]; then
    for dir in "${candidates[@]}"; do
      info "[dry-run] would remove $(short_name "$dir")  ($dir)"
    done
    warn "Dry run — nothing changed."
    return 0
  fi

  local ans=""
  if [ "$pick" = 1 ]; then
    local picked=()
    while read -r dir; do
      [ -n "$dir" ] && picked+=("$dir")
    done < <(pick_worktrees "${rows[@]}")
    [ ${#picked[@]} -eq 0 ] && { warn "Nothing selected — nothing changed."; return 0; }
    candidates=("${picked[@]}")
    step "Selected: ${#candidates[@]}"
    for dir in "${candidates[@]}"; do
      info "$(short_name "$dir")  ($(branch_of "$dir"))"
    done
  elif [ "$yes" != 1 ]; then
    printf '\n  Remove these %s worktrees? [y/N] ' "${#candidates[@]}"
    read -r ans </dev/tty || ans=""
    case "$ans" in
      y|Y|yes|YES) ;;
      *) warn "Aborted — nothing changed."; return 0 ;;
    esac
  fi

  # The picker can reach a dirty worktree, and remove_worktree always passes
  # --force, so this question is the only thing between a wrong mark and
  # uncommitted work. Answer no and the dirty ones drop out, the rest go.
  if [ "$force" != 1 ]; then
    local dirty=() keep=()
    for dir in "${candidates[@]}"; do
      is_dirty "$dir" && dirty+=("$dir")
    done
    if [ ${#dirty[@]} -gt 0 ]; then
      step "Uncommitted changes in ${#dirty[@]}"
      for dir in "${dirty[@]}"; do
        warn "$(short_name "$dir")  ($dir)"
      done
      printf '\n  Remove these too? [y/N] '
      read -r ans </dev/tty || ans=""
      case "$ans" in
        y|Y|yes|YES) ;;
        *) for dir in "${candidates[@]}"; do
             is_dirty "$dir" || keep+=("$dir")
           done
           [ ${#keep[@]} -eq 0 ] && { warn "Nothing left — nothing changed."; return 0; }
           candidates=("${keep[@]}")
           info "keeping the dirty ones, ${#candidates[@]} to go"
           ;;
      esac
    fi
  fi

  local failed=0
  for dir in "${candidates[@]}"; do
    step "Removing $(short_name "$dir")  ($dir)"
    if command -v p0finish >/dev/null 2>&1; then
      if ! p0finish --window "$dir"; then
        warn "p0finish refused — skipped $dir"
        failed=$((failed + 1))
        continue
      fi
    fi
    if ! remove_worktree "$entry" "$dir"; then
      warn "could not remove $dir — skipped"
      failed=$((failed + 1))
      continue
    fi
    info "removed"
  done

  step "Done"
  info "$(( ${#candidates[@]} - failed )) removed, $failed skipped"
}

# ------------------------------------------------------------------- dispatch
case "${1:-list}" in
  new)            shift; cmd_new "$@" ;;
  go|switch)      shift; cmd_go "$@" ;;
  rm|remove)      shift; cmd_rm "$@" ;;
  doctor)         shift; cmd_doctor "$@" ;;
  restore)        shift; cmd_restore "$@" ;;
  prune)          shift; cmd_prune "$@" ;;
  list|ls)        shift; cmd_list "$@" ;;
  -h|--help|help) usage ;;
  # No bare-branch shorthand on purpose: `p0wt eng-8346` reads equally as "go
  # there" and "make that", and guessing wrong either creates junk or does nothing.
  *)              die "unknown command '$1' (try --help)" ;;
esac
