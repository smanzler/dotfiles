export PATH="$HOME/.scripts:$PATH"
export PATH="$HOME/.local/bin:$PATH"

export P0_DEV_NAME=simon-manzler
export P0_DISABLE_GRAFANA=1
export OTEL_SDK_DISABLED=true

# prompt
setopt PROMPT_SUBST

git_prompt() {
  local branch dirty

  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return
  git diff --quiet 2>/dev/null || dirty="%F{red}*%f"

  echo "(%F{10}$branch%f)$dirty"
}

INIT_PROMPT='%(?, ,%F{red}FAIL%f
)
%F{8}%n%f %B%F{blue}%~%f%b $(git_prompt)
'

PROMPT=$INIT_PROMPT
RPROMPT='%F{8}%t%f'

CHAR=$([ $UID -eq 0 ] && echo "#" || echo "$")

function zle-line-init zle-keymap-select {
  case $KEYMAP in
    vicmd) COLOR=magenta ;;
    *)     COLOR=$([ $UID -eq 0 ] && echo red || echo blue ) ;;
  esac

  PROMPT="${INIT_PROMPT}%F{$COLOR}${CHAR}%f "
  zle reset-prompt
}

zle -N zle-line-init
zle -N zle-keymap-select

# homebrew
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# alias
alias vi=nvim
alias vim=nvim
alias gg='nvim "+Neogit kind=replace"'
alias gcplogin='gcloud auth login --update-adc'

# editor
export EDITOR=nvim
export VISUAL=nvim

# docker
export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"

# pnpm
export PNPM_HOME="/Users/simonmanzler/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# zoxide
eval "$(zoxide init zsh)"

# keybinds
bindkey -v
bindkey -M viins 'jk' vi-cmd-mode
bindkey '^y' autosuggest-accept

# straight into neogit; a half-typed line is stashed and comes back afterwards
neogit-widget() {
  [[ -n $BUFFER ]] && zle push-line
  BUFFER='gg'
  zle accept-line
}
zle -N neogit-widget
bindkey '^g' neogit-widget
bindkey -M viins '^g' neogit-widget
bindkey -M vicmd '^g' neogit-widget

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# work
source /Users/simon/.config/op/plugins.sh

# history
HISTSIZE=1000
SAVEHIST=50000
HISTFILE=$HOME/.zsh_history

# plugins
{{- if eq $.chezmoi.os "darwin" }}
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- else if eq $.chezmoi.os "linux" }}
{{-   if eq $.chezmoi.osRelease.id "arch" }}
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{-   else }}
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{-   end }}
{{- end }}
